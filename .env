# 全局 API 地址
# 由于官网可能会有 CORS 跨域问题，可使用反代来解决（请自行搭建）
## 如需了解更多详情，请参阅项目的 README.md 文件。
API_URL="https://api.uptimerobot.com/v2/"

# UptimeRobot API 密钥 - 必需项
## 本项目仅需要只读 API 密钥
## https://dashboard.uptimerobot.com/integrations
API_KEY="ur2924992-0e25e5ee7d5da5c7bd5bb5d3"

# 部署平台 - 必需项
## cloudflare ( default ) | auto
## 如果你使用的不是cloudflare平台,请更改为 “自动”。
DEPLOYMENT_PLATFORM="cloudflare"

# 站点标题
SITE_TITLE="IMSYY 1站点监测"

# 站点说明
SITE_DESCRIPTION="一个简约的站点监测 | a simple site-status pages, power by uptimerobot"

# 站点关键字
SITE_KEYWORDS="站点监测,监测,监控"

# 站点图标
SITE_LOGO="/favicon.ico"

# ICP 备案
## 在中国，你需要提供一个互联网内容提供商（ICP）备案号。
## https://beian.miit.gov.cn/
SITE_ICP=""

# 统计天数
## 要统计的天数
## 建议你填写 30 至 90 天
COUNT_DAYS=60

# 显示链接
## 是否显示网站链接
SHOW_LINKS=true

# 密码
## 如果你想要保护数据，可以设置一个密码。
SITE_PASSWORD=""
## 用于 JSON 网络令牌（JWT）验证的密钥，必填项。
SITE_SECRE_KEY="site-status"
